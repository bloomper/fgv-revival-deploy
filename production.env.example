DEPLOY_ENV=production
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

WEB_HOST=revival.example.org
API_HOST=revival-api.example.org
# Keycloak, run by fgv-infra-deploy
KEYCLOAK_HOST=auth.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-revival-server:0.1.0
WEB_IMAGE=bloomper/fgv-revival-web:0.1.0
MYSQL_IMAGE=mysql:8.4
CLOUDFLARED_VERSION=2026.10.0

MYSQL_DATABASE=fgvrevival
MYSQL_USER=fgvrevival

# Spexregister's GraphQL API on the shared network, run by spexregister-deploy
SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
# Replaces all data with sample data built on Spexregister's at every start
IMPORT_SAMPLE_DATA=false

# Mail for meeting minutes, through FGV's SMTP relay as for Spexregister
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=noreply@example.org
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.revival@example.org
FEEDBACK_EMAIL=feedback.revival@example.org
UMAMI_WEBSITE_ID=
