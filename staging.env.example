DEPLOY_ENV=staging
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

WEB_HOST=revival-staging.example.org
API_HOST=revival-api-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-revival-server:develop
WEB_IMAGE=bloomper/fgv-revival-web:develop
MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=fgvrevival
MYSQL_USER=fgvrevival

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
API_IMPORT_SAMPLE_DATA=true

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.revival@example.org
FEEDBACK_EMAIL=feedback.revival@example.org
UMAMI_WEBSITE_ID=
