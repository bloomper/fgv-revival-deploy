DEPLOY_ENV=staging
# Staging is published through a Cloudflare Tunnel; production uses no Cloudflare
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml
# The Cloudflare Tunnel connector's image tag, pinned; upgrade it deliberately
CLOUDFLARED_VERSION=2026.10.1

WEB_HOST=revival-staging.example.org
API_HOST=revival-api-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-revival-server:develop
WEB_IMAGE=bloomper/fgv-revival-web:develop
MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=fgvrevival
MYSQL_USER=fgvrevival

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
API_IMPORT_SAMPLE_DATA=true

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv

SPEXREGISTER_WEB_URL=https://register-staging.example.org
SPEXIFY_WEB_URL=https://spexify-staging.example.org
SPEXFLIX_WEB_URL=https://spexflix-staging.example.org
SPEXGRAM_WEB_URL=https://spexgram-staging.example.org
ARCHIVE_WEB_URL=https://archive-staging.example.org

SUPPORT_EMAIL=support.revival@example.org
FEEDBACK_EMAIL=feedback.revival@example.org
UMAMI_WEBSITE_ID=
